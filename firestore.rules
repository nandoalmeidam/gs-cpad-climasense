rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{uid}/ocorrencias/{id} {
      function dono() {
        return request.auth != null && request.auth.uid == uid;
      }
      function registroValido() {
        let d = request.resource.data;
        return d.keys().hasAll(['id', 'bairro', 'tipo', 'descricao', 'data', 'sincronizadoEm'])
          && d.keys().hasOnly(['id', 'bairro', 'tipo', 'descricao', 'data', 'sincronizadoEm'])
          && d.id is string && d.id == id && d.id.size() <= 128
          && d.bairro is string && d.bairro.size() >= 2 && d.bairro.size() <= 100
          && d.tipo in ['Alagamento', 'Deslizamento', 'Falta de água', 'Outro']
          && d.descricao is string && d.descricao.size() >= 10 && d.descricao.size() <= 300
          && d.data is string && d.data.size() <= 40
          && d.data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*$')
          && d.sincronizadoEm is timestamp && d.sincronizadoEm == request.time;
      }
      allow read: if dono();
      allow create: if dono() && registroValido();
      allow update: if dono() && registroValido()
        && request.resource.data.id == resource.data.id
        && request.resource.data.data == resource.data.data;
      allow delete: if dono();
    }
  }
}
